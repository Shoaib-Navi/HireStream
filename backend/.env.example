# Required
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
SECRET_KEY=<long random string used to sign login tokens>

# Optional
PORT=8000
# Extra allowed frontend origins, comma-separated (localhost:5173 and the Vercel frontend are allowed by default)
CLIENT_URL=

# Cloudinary (profile photos, resumes, company logos)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Chatbot (server-side only, never put this key in the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

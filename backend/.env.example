# ── Required ────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Long random string used to sign login sessions (SECRET_KEY is still accepted)
JWT_SECRET=

# ── App ─────────────────────────────────────────────────
PORT=8000
# Public URL of the frontend (used in email links)
APP_URL=http://localhost:5173
# Extra allowed frontend origins, comma-separated
CLIENT_URL=
# Block applying / posting until the user verifies their email
REQUIRE_EMAIL_VERIFICATION=false

# ── Cloudinary (photos, logos, resumes) ─────────────────
CLOUD_NAME=
API_KEY=
API_SECRET=
CLOUDINARY_FOLDER=hirestream

# ── Email (verification, password reset, notifications) ─
# Leave SMTP_HOST empty to print emails to the console during development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HireStream <no-reply@hirestream.dev>

# ── AI assistant (server-side only) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
